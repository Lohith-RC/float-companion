# ==============================================================================
# FloatCompanion Environment Configuration Template
# ==============================================================================

# Primary Ultra-Low Latency AI Engine (Groq - https://console.groq.com)
VITE_GROQ_API_KEY=gsk_your_groq_api_key_here

# Multimodal & Deep Reasoning AI Engine (Google Gemini - https://aistudio.google.com)
VITE_GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Optional Fallback Providers
VITE_OPENAI_API_KEY=sk_your_openai_api_key_here
VITE_ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Local Offline AI Engine (Ollama - default: http://127.0.0.1:11434)
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Application Settings
VITE_APP_NAME="FloatCompanion"
VITE_DEFAULT_MODEL="groq/llama-3.3-70b-versatile"
